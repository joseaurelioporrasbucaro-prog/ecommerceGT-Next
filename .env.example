# URL base del backend ecommerceGTBackEnd.
# En desarrollo local el backend corre en http://localhost:4000.
# Importante: la variable empieza con NEXT_PUBLIC_ para que esté disponible en el cliente.
NEXT_PUBLIC_API_URL=

# URL canónica del sitio publicado. Usada por SEO (sitemap, JSON-LD, OG).
# Ej: https://kiosqui.gt
NEXT_PUBLIC_SITE_URL=

# ============================================================================
# Fase 23 — Cloudflare Turnstile (captcha anti-bot en /contact)
# ----------------------------------------------------------------------------
# Crear sitio en https://dash.cloudflare.com → Turnstile → Add site.
# Sitekey de testing "always pass" para dev: 1x00000000000000000000AA
# ⚠️ NO commitear la sitekey real — va en .env.local (en .gitignore).
# ============================================================================
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
